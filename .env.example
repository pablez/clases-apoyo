# Variables de entorno para desarrollo
# Copia este archivo como .env y ajusta los valores

# ==== AUTENTICACIÓN MVP ====
ADMIN_PASSWORD=admin123

# ==== OPCIÓN 1: SHEETY/STEIN (recomendado para MVP) ====
# Si usas Sheety o Stein, define la URL base de tu API
# SHEETY_BASE_URL=https://api.sheety.co/tu-usuario/tu-proyecto
# SHEETY_TOKEN=tu_token_opcional

# ==== OPCIÓN 2: GOOGLE SHEETS DIRECTO ====
# Si prefieres acceso directo con googleapis
# USE_GOOGLE_SHEETS=true
# GOOGLE_SHEET_ID=tu-spreadsheet-id-completo
# 
# Producción (Netlify): recomendado usar variable, no archivo.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}           # JSON en una sola línea
# o alternativamente Base64:
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwuLi59
#
# Desarrollo local (solo si te sirve): ruta a archivo JSON (NO subir al repo)
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./backups/llave-educacion.json

# Nota: No subas tu archivo .json de service account al repositorio.
# Añade educacion-llave.json a .gitignore (ya está configurado).
